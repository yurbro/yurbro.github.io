<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="list-group-item">
      <div class="resume-work-entry">
        <div class="resume-work-date">
          {% if content.startDate %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' %}
            {% assign date = date | append: endDate %}
            <span class="badge font-weight-bold danger-color-dark text-uppercase">{{ date }}</span>
          {% endif %}
        </div>
        <div class="resume-work-details">
          <h6 class="title font-weight-bold resume-work-title">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.position }}</a>
            {% else %}
              {{ content.position }}
            {% endif %}
          </h6>
          {% if content.location %}
            <p class="resume-work-location">
              <i class="fa-solid fa-location-dot iconlocation" aria-hidden="true"></i>
              {{ content.location }}
            </p>
          {% endif %}
          <h6 class="resume-work-institution">{{ content.name }}</h6>
          {% if content.summary %}
            {% assign summary_html = content.summary | escape %}
            {% if content.summaryPeople and content.summaryPeople.size > 0 %}
              {% for person in content.summaryPeople %}
                {% capture person_link %}<a href="{{ person.url | escape }}" target="_blank" rel="noopener noreferrer">{{ person.name | escape }}</a>{% endcapture %}
                {% assign summary_html = summary_html | replace: person.name, person_link %}
              {% endfor %}
            {% endif %}
            <p class="resume-work-summary">{{ summary_html }}</p>
          {% endif %}
          {% if content.teachingCourses and content.teachingCourses.size > 0 %}
            <ul class="items resume-work-highlights">
              {% for course in content.teachingCourses %}
                <li>
                  <span class="item">
                    {{ course.code | escape }} {{ course.title | escape }}
                    {% if course.years %}({{ course.years | escape }}){% endif %}
                    {% if course.description %} — {{ course.description | escape }}{% endif %}
                    {% if course.lecturer %}
                      <span class="resume-teaching-lecturer">
                        · Lecturer:
                        <a href="{{ course.lecturer.url | escape }}" target="_blank" rel="noopener noreferrer">{{ course.lecturer.name | escape }}</a>
                      </span>
                    {% endif %}
                  </span>
                </li>
              {% endfor %}
            </ul>
          {% elsif content.highlights %}
            <ul class="items resume-work-highlights">
              {% for item in content.highlights %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
