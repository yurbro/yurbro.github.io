<div class="academic-service">
  <h5>Journal peer review</h5>
  <ul class="academic-service-list">
    {% for item in data[1].journals %}
      <li><strong>{{ item.name }}</strong> — {{ item.details }}</li>
    {% endfor %}
  </ul>
  <h5 class="mt-3">Conference reviewing</h5>
  <ul class="academic-service-list">
    {% for item in data[1].conferences %}
      <li><strong>{{ item.name }}</strong> — {{ item.details }}</li>
    {% endfor %}
  </ul>
  <p class="mt-3"><a href="{{ '/activities/' | relative_url }}">Conference activities and photo journal</a></p>
</div>
