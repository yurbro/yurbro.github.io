<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle">{{ content.date | date: '%d %b %Y' }}</span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.name }}</h6>
          <p class="ml-1 ml-md-4">{{ content.authors }}</p>
          <p class="ml-1 ml-md-4">{{ content.event }} · {{ content.location }}</p>
          <p class="ml-1 ml-md-4">{{ content.summary }}</p>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
