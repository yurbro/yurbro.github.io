<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.startDate and content.startDate != '' %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' %}
            {% assign date = date | append: endDate %}
          {% else %}
            {% assign date = null %}
          {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if date %}
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                  {% endif %}
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.studyType }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.institution }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.area }}</h6>
          {% if content.supervisors and content.supervisors.size > 0 %}
            <p class="resume-education-people ml-1 ml-md-4">
              <strong>
                {%- if content.supervisors.size > 1 %}Supervisors{% else %}Supervisor{% endif %}:</strong
              >
              {% for person in content.supervisors %}
                <a href="{{ person.url | escape }}" target="_blank" rel="noopener noreferrer">{{ person.name | escape }}</a>
                {% unless forloop.last %}, {% endunless %}
              {% endfor %}
            </p>
          {% endif %}
          {% if content.academicContacts and content.academicContacts.size > 0 %}
            <p class="resume-education-people ml-1 ml-md-4">
              {% for person in content.academicContacts %}
                {{ person.label | escape }}:
                <a href="{{ person.url | escape }}" target="_blank" rel="noopener noreferrer">{{ person.name | escape }}</a>
                {% unless forloop.last %} · {% endunless %}
              {% endfor %}
            </p>
          {% endif %}
          {% if content.researchFocus %}
            <p class="resume-education-research ml-1 ml-md-4"><strong>Research focus:</strong> {{ content.researchFocus | escape }}</p>
          {% endif %}
          {% if content.researchHighlights and content.researchHighlights.size > 0 %}
            <ul class="items resume-education-highlights">
              {% for highlight in content.researchHighlights %}
                <li>
                  <span class="item">{{ highlight | escape }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if content.relatedPublications and content.relatedPublications.size > 0 %}
            <p class="resume-education-publications ml-1 ml-md-4">
              <strong>Related publications:</strong>
              {% for publication in content.relatedPublications %}
                <a href="{{ publication.url | escape }}" target="_blank" rel="noopener noreferrer">{{ publication.name | escape }}</a>
                {% unless forloop.last %} · {% endunless %}
              {% endfor %}
            </p>
          {% endif %}
          <ul class="items">
            {% for item in content.courses %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
