<section
  class="academic-metrics"
  data-academic-stats-url="https://raw.githubusercontent.com/yurbro/yurbro.github.io/academic-stats/academic-stats.json"
  aria-labelledby="academic-metrics-title"
>
  <div class="academic-metrics-heading">
    <div>
      <div class="academic-metrics-kicker">Research impact</div>
      <h2 id="academic-metrics-title">Academic metrics</h2>
    </div>
    <a class="academic-metrics-source" href="https://openalex.org" aria-label="Open OpenAlex data source">
      <i class="fa-solid fa-rotate" aria-hidden="true"></i> Refreshed daily from OpenAlex
    </a>
  </div>

  <div class="academic-metrics-grid" aria-live="polite">
    <div class="academic-metric-card">
      <span class="academic-metric-icon" aria-hidden="true"><i class="fa-solid fa-quote-right"></i></span>
      <strong data-academic-citations>—</strong>
      <span>Citations</span>
    </div>
    <div class="academic-metric-card">
      <span class="academic-metric-icon" aria-hidden="true"><i class="fa-solid fa-chart-column"></i></span>
      <strong data-academic-h-index>—</strong>
      <span>h-index</span>
    </div>
    <div class="academic-metric-card">
      <span class="academic-metric-icon" aria-hidden="true"><i class="fa-solid fa-lock-open"></i></span>
      <strong data-academic-open-access>—</strong>
      <span>Open-access works</span>
    </div>
    <div class="academic-metric-card">
      <span class="academic-metric-icon" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span>
      <strong data-academic-coverage>—</strong>
      <span>DOI coverage</span>
    </div>
  </div>

  <p class="academic-metrics-note">
    Calculated from DOI-linked publications listed on this website. Citation coverage differs across scholarly databases, so these figures may not
    match Google Scholar exactly. <time data-academic-updated></time>
  </p>
</section>

<script defer src="{{ '/assets/js/academic-metrics.js' | relative_url }}"></script>
