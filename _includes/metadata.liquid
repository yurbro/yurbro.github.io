{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip %}
{% assign meta_description = page.description | default: site.description | strip %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>
  {% if site.title == 'blank' %}
    {% capture title %}{{ author_name }}{% endcapture %}
  {% else %}
    {% capture title %}{{ site.title }}{% endcapture %}
  {% endif %}
  {% if page.url == '/blog/index.html' %}
    {{ page.title }} | {{ title }}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {% if page.title == null or page.title == '' %}
      {{ page.date | date: '%Y' }} | {{ title }}
    {% else %}
      {{ page.title }} | {{ title }}
    {% endif %}
  {% else %}
    {{ title }}
  {% endif %}
</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ meta_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  {% assign social_title = author_name %}
  {% if page.url != '/' and page.title != blank %}
    {% assign social_title = page.title | capitalize | append: ' | ' | append: author_name %}
  {% endif %}

  {% comment %}The site OG image uses a root-relative path; emit an absolute URL for previews.{% endcomment %}
  {% assign share_image = page.og_image | default: site.og_image %}
  {% if share_image != blank %}
    {% unless share_image contains '://' %}
      {% assign share_image = share_image | absolute_url %}
    {% endunless %}
  {% endif %}

  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ author_name | escape }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ social_title | escape }}">
  <meta property="og:url" content="{{ page.url | absolute_url }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  {% if share_image != blank %}
    <meta property="og:image" content="{{ share_image | escape }}">
    <meta property="og:image:alt" content="Black-and-white portrait illustration of Yu Zhang">
  {% endif %}
  <meta property="og:locale" content="{{ site.lang }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ social_title | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  {% if share_image != blank %}
    <meta name="twitter:image" content="{{ share_image | escape }}">
    <meta name="twitter:image:alt" content="Black-and-white portrait illustration of Yu Zhang">
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  {% comment %}
    Build JSON-LD using Liquid's jsonify filter so apostrophes, newlines
    and other special characters cannot invalidate the structured data.
    Identity URLs come from the same public socials.yml that powers the site.
  {% endcomment %}
  {% assign same_as_links = '' | split: ',' %}
  {% if site.data.socials.orcid_id %}
    {% capture identity_link %}https://orcid.org/{{ site.data.socials.orcid_id }}{% endcapture %}
    {% assign same_as_links = same_as_links | push: identity_link %}
  {% endif %}
  {% if site.data.socials.scholar_userid %}
    {% capture identity_link %}https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}{% endcapture %}
    {% assign same_as_links = same_as_links | push: identity_link %}
  {% endif %}
  {% if site.data.socials.github_username %}
    {% capture identity_link %}https://github.com/{{ site.data.socials.github_username }}{% endcapture %}
    {% assign same_as_links = same_as_links | push: identity_link %}
  {% endif %}
  {% if site.data.socials.linkedin_username %}
    {% capture identity_link %}https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}{% endcapture %}
    {% assign same_as_links = same_as_links | push: identity_link %}
  {% endif %}
  {% if site.data.socials.research_gate_profile %}
    {% capture identity_link %}https://www.researchgate.net/profile/{{ site.data.socials.research_gate_profile }}{% endcapture %}
    {% assign same_as_links = same_as_links | push: identity_link %}
  {% endif %}
  {% if site.data.socials.work_url %}
    {% assign same_as_links = same_as_links | push: site.data.socials.work_url %}
  {% endif %}

  {% assign homepage_url = '/' | absolute_url %}
  {% assign person_id = homepage_url | append: '#person' %}
  {% assign website_id = homepage_url | append: '#website' %}
  {% assign webpage_url = page.url | absolute_url %}
  {% assign webpage_id = webpage_url | append: '#webpage' %}
  {% assign person_image = '/assets/img/prof_pic.jpg' | absolute_url %}
  {% assign schema_page_title = author_name %}
  {% if page.url != '/' and page.title != blank %}
    {% assign schema_page_title = page.title | capitalize | append: ' | ' | append: author_name %}
  {% endif %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": {{ person_id | jsonify }},
          "name": {{ author_name | jsonify }},
          "url": {{ homepage_url | jsonify }},
          "image": {{ person_image | jsonify }},
          "affiliation": {
            "@type": "CollegeOrUniversity",
            "name": "University of Surrey",
            "url": "https://www.surrey.ac.uk/"
          },
          "sameAs": {{ same_as_links | jsonify }}
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | jsonify }},
          "url": {{ homepage_url | jsonify }},
          "name": {{ author_name | jsonify }},
          "description": {{ site.description | strip | jsonify }},
          "publisher": {"@id": {{ person_id | jsonify }}}
        },
        {
          "@type": "{% if is_blog_post %}BlogPosting{% else %}WebPage{% endif %}",
          "@id": {{ webpage_id | jsonify }},
          "url": {{ webpage_url | jsonify }},
          "name": {{ schema_page_title | jsonify }},
          "description": {{ meta_description | jsonify }},
          "isPartOf": {"@id": {{ website_id | jsonify }}},
          "author": {"@id": {{ person_id | jsonify }}}
          {% if page.url == '/' %},
          "about": {"@id": {{ person_id | jsonify }}}
          {% endif %}
        }
      ]
    }
  </script>
{% endif %}
